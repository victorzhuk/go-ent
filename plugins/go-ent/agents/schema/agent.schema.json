{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/victorzhuk/go-ent/agents/schema/agent.schema.json",
  "title": "Agent Definition Schema",
  "description": "Schema for go-ent agent metadata definitions",
  "type": "object",
  "required": ["name", "description", "model"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^ent:[a-z0-9-]+$",
      "description": "Agent name with 'ent:' prefix"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Brief description of agent's purpose"
    },
    "model": {
      "type": "string",
      "enum": ["fast", "main", "heavy"],
      "description": "Model tier (maps to actual models via resolver)"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "description": "Hex color code for UI display"
    },
    "role": {
      "type": "string",
      "enum": ["planning", "execution", "validation", "research"],
      "description": "Agent's primary role category"
    },
    "complexity": {
      "type": "string",
      "enum": ["simple", "standard", "heavy"],
      "description": "Complexity level of tasks this agent handles"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "uniqueItems": true,
      "description": "List of skill names the agent uses"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Explicit tool list (usually use toolPresets instead)"
    },
    "toolPresets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["read-only", "editing", "serena-analysis", "serena-editing"]
      },
      "uniqueItems": true,
      "description": "Tool preset names to include"
    },
    "disallowedToolPresets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["read-only", "editing", "serena-analysis", "serena-editing"]
      },
      "uniqueItems": true,
      "description": "Tool preset names to exclude/disallow"
    },
    "disallowedTools": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "Explicit tools to disallow"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ent:[a-z0-9-]+$"
      },
      "uniqueItems": true,
      "description": "Other agents this agent may delegate to"
    }
  },
  "additionalProperties": false
}
